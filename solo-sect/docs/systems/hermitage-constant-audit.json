{
  "about": "Phase 4–7 numerical source lines, plus inherited lines touched by integration; line hashes let the auditor detect changed values without duplicating code.",
  "baseline": "535dacd",
  "groups": {
    "phase4_people": {
      "category": "設計旋鈕",
      "source": "Phase 4 #509／詳細起手契約",
      "reason": "起手技能、武學 XP、好感與同住時間決定雙人初始差距；本項只分類已獲授權的既存數值，不改驗收值。"
    },
    "phase4_arts": {
      "category": "設計旋鈕",
      "source": "Phase 4 #509 與既有 TIERS／武學品級",
      "reason": "武學品級、前置級數與效果倍率是 Phase 4 已批准的設計值，不是從真實世界量測或公式唯一算出。"
    },
    "phase5_body": {
      "category": "設計旋鈕",
      "source": "Phase 5 #510 規格／BODY_CONDITION",
      "reason": "疲勞、日增長和藥膳恢復數值調整做活節奏；這些是已授權的原規格值。"
    },
    "phase5_visual": {
      "category": "設計旋鈕",
      "source": "Phase 5 #510 微距畫面契約",
      "reason": "畫面級距、晃動及光暈尺寸只控制可見的勞作姿態與特效，不寫回模擬。"
    },
    "phase6_gate": {
      "category": "設計旋鈕",
      "source": "Phase 6 #511 山崖與入內前置規格",
      "reason": "外功 XP、體魄及崖段身法門檻界定可穩定完成的動作；保持規格指定值。"
    },
    "phase6_activity": {
      "category": "設計旋鈕",
      "source": "Phase 6 #511 活動表與既有採藥／練功工時",
      "reason": "崖段工時、耗力與收集量參照舊活動，但具體數值仍是 Phase 6 已批准的節奏設計值。"
    },
    "phase6_effect": {
      "category": "設計旋鈕",
      "source": "Phase 6 #511 由外而內效果契約",
      "reason": "心法、輕功與崖段練體倍率直接取已批准規格，連到原傷害、耗力和移動公式。"
    },
    "phase6_visual": {
      "category": "設計旋鈕",
      "source": "Phase 6 #511 微距與地圖畫面契約",
      "reason": "節點座標、上躍弧線及岩壁幾何用既有 Canvas 尺度排出可辨三段動作，不影響模擬位置。"
    },
    "phase7_founding": {
      "category": "設計旋鈕",
      "source": "Phase 7 #512 開山規格",
      "reason": "開山階段與初始名聲沿已批准的立宗收益；未提前給舊開局。"
    },
    "phase7_twin": {
      "category": "設計旋鈕",
      "source": "Phase 7 #512 雙劍規格",
      "reason": "合璧倍率及近身畫面沿已批准規格，只在真同場交手判定。"
    },
    "inherited": {
      "category": "推導",
      "source": "Phase 4 前既有規則／535dacd 基線",
      "reason": "此行因 Phase 4–7 接線而出現在 diff；數值原本已在通用規則，並非本期新旋鈕。",
      "scope": "inherited"
    },
    "h0": {
      "category": "推導",
      "source": "H0 #518／原奇遇排程",
      "reason": "遷移後允許原奇遇重新排程，沿用既有未觸發時間哨兵。",
      "scope": "later"
    },
    "phase4_visual": {
      "category": "設計旋鈕",
      "source": "Phase 4 #509 合參畫面契約",
      "reason": "雙人同坐的 Canvas 座標及縮放只呈現關係階段，不改時間、相性或戰鬥。"
    },
    "phase6_arts": {
      "category": "設計旋鈕",
      "source": "Phase 6 #511 與既有武學品級／內功 schema",
      "reason": "羅漢路新武學的品級與效果值是 Phase 6 已批准的設計值；既有武學 schema 決定欄位形式，沒有唯一決定數值。"
    },
    "r4_reused": {
      "category": "設計旋鈕",
      "source": "R4 #520 將 Phase 4／7 已批准的起手、共修與開山數值改放資料列",
      "reason": "搬移原值，不增加新門檻或調整 A／B；之後若要調手感值須另取擁有人同意。",
      "scope": "r4"
    },
    "r4_relationship": {
      "category": "推導",
      "source": "R4 #520 與原 initPair／pairBest 好感模型",
      "reason": "0.1 與 60 是原同門默契比例及好感刻度；正式師徒另沿既有 APPR.aff，無新好感常數。",
      "scope": "r4"
    },
    "r4_visual": {
      "category": "設計旋鈕",
      "source": "Phase 4 合參 Canvas 既有位置與 R4 #520 人物泛化",
      "reason": "畫布座標及共修分段從原畫面搬來，不改模擬。",
      "scope": "r4"
    },
    "r2_measured": {
      "category": "量測",
      "source": "Banister & Calvert 1980；Busso 2003（fitness–fatigue 模型時間常數）",
      "reason": "體能約 42 日、疲勞約 7 日的衰減時間常數是運動科學量測值，不調手感。",
      "scope": "r2"
    },
    "r2_reference": {
      "category": "推導",
      "source": "Project Zomboid 營養規則（蛋白質足 ×1.5、不足 ×0.7）；data.mjs STATS 根骨 1–5；Rippetoe《Starting Strength》、ExRx 力量標準表（未受訓→進階約兩三倍）",
      "reason": "借用既有遊戲的營養倍率與本作根骨尺度，不另設新數。",
      "scope": "r2"
    },
    "r2_knob": {
      "category": "設計旋鈕",
      "source": "R2 #521（擁有人 2026-11-08 D2：飲食不破上限）",
      "reason": "一天約八小時全力重活可長期維持；各份活對幾點力氣／身法算全力。痠痛門檻與體能尺度都由此推導。",
      "scope": "r2"
    },
    "r2_derived": {
      "category": "推導",
      "source": "R2 #521 economy.mjs SORE_AT／FITNESS_SCALE／muscleFatigue",
      "reason": "由上面的時間常數與旋鈕算出（穩態公式、顯示百分比、1−e^(−2) 尺度），不是獨立數值。",
      "scope": "r2"
    },
    "r7_measured": {
      "category": "量測",
      "scope": "r7",
      "source": "Gnoth 等 2003（一年內受孕約 85%）；足月 40 週；ACOG 第 589 號（40 歲後受孕率）；IOM 2009 孕期增重；WHO 出生性別比 105:100",
      "reason": "懷孕與生育的時間、機率與體重變化採醫學量測值，不為節奏調整。"
    },
    "r7_reference": {
      "category": "參考",
      "scope": "r7",
      "source": "RimWorld Biotech 生命階段（嬰兒期到 3 歲）",
      "reason": "嬰兒期長度借遊戲的分期概念，只決定何時開始自己找事做。"
    },
    "r7_inherited": {
      "category": "設計旋鈕",
      "scope": "r7",
      "source": "既有 GEN（v1.4）與收養範本",
      "reason": "一年 28 日、14 歲成年，以及新生兒的需求、好感起點沿用舊收養規格；R7 只改由誰生、何時長。"
    }
  },
